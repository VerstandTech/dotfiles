{
  "version": 1,
  "projectLabel": "leo-pi-personal",
  "strictGreenCoversRed": true,
  "commands": {
    "unitTest": "bun test"
  },
  "featurePathPatterns": ["**/tests/features/**", "**/*.feature"],
