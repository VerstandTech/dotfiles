{
  "version": 1,
  "enabledByDefault": false,
  "projectLabel": "my-project",
  "featurePathPatterns": [
    "**/*.feature",
    "**/tests/features/**"
  ],
  "testPathPatterns": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/tests/unit/**",
    "**/tests/integration/**",
    "**/tests/e2e/**",
    "**/tests/features/_steps/**",
    "**/tests/features/_generated/**",
    "**/tests/features/_harnesses/**"
  ],
  "implementationPathPatterns": [
    "**/src/**",
    "**/app/**",
    "**/packages/**/src/**",
    "**/components/**",
    "**/hooks/**",
    "**/server/**",
    "**/domain/**",
    "**/application/**",
    "**/infrastructure/**"
  ],
  "docsPathPatterns": [
    "**/docs/**",
    "**/AGENTS.md",
    "**/TARGET_PUBLIC.md",
    "**/*example*map*"
  ],
  "configPathPatterns": [
    "**/.pi/bdd.json",
    "**/package.json",
    "**/tsconfig*.json"
  ],
  "alwaysAllowPathPatterns": [
    "**/tests/features/_generated/**",
    "**/messages/**/*.json"
  ],
  "commands": {
    "unitTest": "bun test",
    "acceptanceTest": "bun run gherkin:test",
    "acceptanceGenerate": "bun run gherkin:generate",
    "typecheck": "bun run typecheck",
    "staticAnalysis": "bun run lint",
    "coverage": "bun run coverage",
    "mutation": "bun run mutation",
    "architecture": "bun run architecture",
    "doctor": "bun run doctor",
    "security": "bun run security"
  },
  "assurance": {
    "enabled": true,
    "requiredGateKinds": ["unit", "types", "coverage"],
    "advisoryGateKinds": ["static", "mutation", "architecture", "doctor", "security", "performance"],
    "coverageThreshold": 95,
    "mutationThreshold": 80,
    "doctorThreshold": 90,
    "defaultTimeoutMs": 120000
  },
  "_comment": "Prefer /bdd init so local stack detection fills real commands. Remove unavailable placeholder commands rather than installing tools implicitly."
}
