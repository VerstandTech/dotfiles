# Copy to docs/graphiti/.env only if you are not using scripts/setup-graphiti.sh.
# .env is gitignored. Do not put real secrets in git.
#
# Cloud OpenAI-compatible:
#   OPENAI_API_KEY=sk-...
#   OPENAI_API_URL=https://api.openai.com/v1
#   MODEL_NAME=gpt-4o-mini
#   EMBEDDER_MODEL=text-embedding-3-small
#   EMBEDDER_DIMENSIONS=1536
#
# Local Ollama (setup script default when no cloud key is set):
#   OPENAI_API_KEY=ollama
#   OPENAI_API_URL=http://host.docker.internal:11434/v1
#   MODEL_NAME=llama3.2
#   EMBEDDER_MODEL=nomic-embed-text
#   EMBEDDER_DIMENSIONS=768
